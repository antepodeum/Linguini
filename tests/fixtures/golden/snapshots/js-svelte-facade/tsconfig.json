{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "skipLibCheck": true
  },
  "include": ["consumer.js", "*/svelte.js", "*/typescript/svelte.ts", "framework.d.ts"]
}
