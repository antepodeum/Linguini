enum Gender { male, other }
let prefix = Total
impl Fruit {
apple {
Gender = male
form label(Plural) {
one => One {prefix}
_ => Many {prefix}
}
}
}
fn Render(Gender, Plural) {
male {
one => One
_ => Many
}
other {
one => Other one
_ => Other many
}
}
summary = {Render(fruit.Gender, count)}: {fruit.label(count)}
