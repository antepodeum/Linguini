enum Tone { formal, casual }

override enum Channel { email, sms }

let product_name = Linguini

form Greeting(Tone, Plural) {
  formal {
    one => Hello
    _ => Hello
  }
  casual {
    one => Hey
    _ => Hey
  }
}

fn Wrap(Tone, value: String) {
  formal => {value}
  _ => {value}
}

/// Greeting shown in account header.
greeting = {Greeting(tone, count)}, {Wrap(tone, name)}

account {
  title = Account
  subtitle = {count} updates
}

inline_greeting = Hello {fn(tone) {
  formal => "Dear, " {name},
  _ => Hi {name}
}}!

inline_nested = {fn(tone, Plural(count), greet: Greeting(tone, count)) {
  formal {
    one => "Dear, } "{greet} {name}
    other => Dear {greet} {name}
  }
  _ {
    _ => Hi {name}
  }
}}

quote_text = He said "hello" and measured 6"
quoted_text = "\"hello\"\n\t\u{1F34E}\0"
block_text = """
  Hello "friend", {name}.
    C:\new\test
"""
wire_text = raw"""  "hello"
  {product_name}  """
