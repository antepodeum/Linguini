{
  "name": "@antepodeum/linguini-sveltekit",
  "version": "0.1.0-alpha.4",
  "description": "SvelteKit runtime hooks and request-locale integration for Linguini",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antepodeum/Linguini.git",
    "directory": "packages/sveltekit"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "svelte": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "pnpm build && node --test",
    "check": "tsc --project tsconfig.json --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@antepodeum/linguini-web": "0.1.0-alpha.4",
    "@antepodeum/linguini-svelte": "0.1.0-alpha.4"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.57.0",
    "svelte": "^5.55.0",
    "@antepodeum/linguini-vite": "0.1.0-alpha.4"
  },
  "devDependencies": {
    "@sveltejs/kit": "2.60.1",
    "svelte": "5.55.8",
    "typescript": "6.0.3",
    "@types/node": "24.12.4",
    "@antepodeum/linguini-vite": "0.1.0-alpha.4"
  },
  "peerDependenciesMeta": {
    "@antepodeum/linguini-vite": {
      "optional": true
    }
  }
}
