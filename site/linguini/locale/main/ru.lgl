
enum Gender { male, female, neuter, other }

impl Fruit {
  apple {
    Gender = neuter
    emoji = 🍎

    form nom(Plural) {
      one => яблоко
      few => яблока
      _   => яблок
    }
  }

  pear {
    Gender = female
    emoji = 🍐

    form nom(Plural) {
      one => груша
      few => груши
      _   => груш
    }
  }

  orange {
    Gender = male
    emoji = 🍊

    form nom(Plural) {
      one => апельсин
      few => апельсина
      _   => апельсинов
    }
  }
}

form SizeAdj(Size, Plural, Gender) {
  small {
    one {
      male   => маленький
      female => маленькая
      neuter => маленькое
      _      => маленький
    }
    few {
      female => маленькие
      _      => маленьких
    }
    _ => маленьких
  }

  big {
    one {
      male   => большой
      female => большая
      neuter => большое
      _      => большой
    }
    few {
      female => большие
      _      => больших
    }
    _ => больших
  }

  _ {
    one {
      male   => обычный
      female => обычная
      neuter => обычное
      _      => обычный
    }
    few {
      female => обычные
      _      => обычных
    }
    _ => обычных
  }
}

form SizeWord(Size) {
  small => маленький
  big   => большой
  _     => обычный
}

form Delivered(Plural, Gender) {
  one {
    male   => Доставлен
    female => Доставлена
    neuter => Доставлено
    _      => Доставлено
  }
  _ => Доставлено
}

let size_form_label = Форма размера

nav {
  why = Зачем
  language = Язык
  codegen = Кодогенерация
  web = Веб
  locale_label = Локаль
}

hero {
  eyebrow = Типизированная локализация для продуктовых команд
  title = Linguini
  tagline = Интернационализация для всех нас
  copy = Типизированная локализация с компиляцией сообщений и CLDR-форматирования, переиспользуемыми веб-адаптерами и интеграциями фреймворков.
  term = /lɪŋˈɡwiːni/
  term_kind = СУЩ.
  term_hint = длинная тонкая ленточная паста
  intro = Linguini превращает locale-файлы, связанные со схемой, в типизированный сгенерированный код. До генерации check/build сообщают об отсутствующих реализациях и проверяют поддерживаемое использование форматтеров, а также вызовы и ветви dispatch, которые анализатор способен разрешить.
  trait_typed = Типизированный
  trait_compiled = Компилируемый
  trait_native = Нативный
  primary_cta = Документация
  secondary_cta = GitHub
}

codegen {
  kicker = Генерация кода
  title = Одна схема — JavaScript с типами TypeScript
  intro = Linguini анализирует контракты .lgs и логику локалей .lgl, затем компилирует модули сообщений со специализированными CLDR-форматтерами и plural-селекторами.
  ts_title = JavaScript + .d.ts
  ts_desc = Сгенерированные ESM и .d.ts для строгого TypeScript; Vite выбирает используемые на странице сообщения и их зависимости.
  svelte_title = Svelte 5 + SvelteKit
  svelte_desc = Переиспользуемое состояние Svelte и хуки запросов SvelteKit; маршрутизация и сохранение локали настраиваются в коде приложения.
  planned_title = Запланированные таргеты
  planned_intro = План намеренно широкий: Linguini должен поддерживать все практичные рантаймы, языки и web-фреймворки.
  rust = Rust
  kotlin = Kotlin
  swift = Swift
  go = Go
  python = Python
  csharp = C#
  status_shipped = Стабильно
  status_planned = В планах
}

web {
  kicker = SvelteKit
  title = Локализованный SvelteKit без ручной i18n-обвязки
  intro = Пишите обычные маршруты SvelteKit и вызывайте сгенерированные сообщения. Linguini хранит активную локаль и реактивно обновляет текст. Сигнатуры сгенерированных сообщений позволяют TypeScript сообщать о неверных аргументах при проверке типов приложения.
  routing = Используйте обычные внутренние ссылки; локализованные URL обрабатывает рантайм-адаптер SvelteKit.
  cookie = Настраивайте cookie и хранилище браузера через политику рантайма в коде приложения.
  fallback = Отсутствующие переводы разрешаются для каждого сообщения при сборке.
  reactivity = Перед обновлением реактивного интерфейса смена локали подготавливает нужные сообщения.
  links = Для отдельных ссылок можно оставить исходный URL нелокализованным.
}

playground {
  kicker = Интерактивная песочница
  title = Меняйте количество, фрукт, размер, род, сумму, дату или локаль.
  count_label = Количество
  fruit_label = Фрукт
  fruit_apple_label = яблоко
  fruit_pear_label = груша
  fruit_orange_label = апельсин
  size_label = Размер
  size_small_label = маленький
  size_big_label = большой
  amount_label = Сумма
  date_label = Дата
  localized_path_label = Локализованный маршрут
  cookie_label = Cookie
  route_label = Префикс маршрута
  sentence = {Delivered(count, fruit.Gender)} {count} {SizeAdj(size, count, fruit.Gender)} {fruit.nom(count)}. Итого {amount @currency(code = "RUB")}; дата {date}.
  cart_summary = В корзине {count} {fruit.nom(count)}
  number_format = Формат числа: {value}
  currency_format = Формат валюты: {amount @currency(code = "RUB")}
  date_format = Формат даты: {date}
  override_format = Переопределение локали: {amount @number} / {date @date(style = "long")}

  size_line = {size_form_label}: {SizeWord(size)}
}
