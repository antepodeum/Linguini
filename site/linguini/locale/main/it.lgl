
enum Gender { male, female, neuter, other }

impl Fruit {
  apple {
    Gender = neuter
    emoji = 🍎

    form nom(Plural) {
      one => mela
      _   => mele
    }
  }

  pear {
    Gender = female
    emoji = 🍐

    form nom(Plural) {
      one => pera
      _   => pere
    }
  }

  orange {
    Gender = male
    emoji = 🍊

    form nom(Plural) {
      one => arancia
      _   => arance
    }
  }
}

form SizeAdj(Size, Plural, Gender) {
  small {
    one {
      male   => piccolo
      female => piccola
      neuter => piccolo
      _      => piccolo
    }
    _ {
      male   => piccoli
      female => piccole
      neuter => piccoli
      _      => piccoli
    }
  }
  big {
    one {
      male   => grande
      female => grande
      neuter => grande
      _      => grande
    }
    _ {
      male   => grandi
      female => grandi
      neuter => grandi
      _      => grandi
    }
  }
  _ => normali
}

form SizeWord(Size) {
  small => piccolo
  big   => grande
}

form Delivered(Plural, Gender) {
  one {
    _ => Consegnato
  }
  _ => Consegnati
}

let size_form_label = Forma dimensione

nav {
  why = Perché
  language = Lingua
  codegen = Codegen
  web = Web
  locale_label = Lingua
}

hero {
  eyebrow = Localizzazione tipizzata per team di prodotto
  title = Linguini
  tagline = Internazionalizzazione per tutti noi
  copy = Localizzazione tipizzata con messaggi e formattazione CLDR compilati, più adapter web e framework riutilizzabili.
  term = /lɪŋˈɡwiːni/
  term_kind = NOME
  term_hint = pasta lunga e stretta a nastri
  intro = Linguini trasforma file locale legati allo schema in codice generato tipizzato. Prima della generazione, check/build segnalano implementazioni mancanti e validano gli usi supportati dei formattatori, oltre alle chiamate locale e ai rami di dispatch che l'analizzatore riesce a risolvere.
  trait_typed = Tipizzato
  trait_compiled = Compilato
  trait_native = Nativo
  primary_cta = Leggi docs
  secondary_cta = Vedi GitHub
}

codegen {
  kicker = Generazione codice
  title = Uno schema, JavaScript con tipi TypeScript
  intro = Linguini analizza i contratti .lgs e la logica .lgl, poi compila moduli di messaggi con formattatori CLDR specializzati e selettori plurali.
  ts_title = JavaScript + .d.ts
  ts_desc = ESM e .d.ts generati per TypeScript strict; Vite seleziona messaggi e dipendenze usati da ogni pagina.
  svelte_title = Svelte 5 + SvelteKit
  svelte_desc = Stato Svelte riutilizzabile e hook delle richieste SvelteKit; routing e persistenza si configurano nel codice dell'applicazione.
  planned_title = Target pianificati
  planned_intro = La roadmap è volutamente ampia: Linguini punta a supportare ogni runtime, linguaggio e framework web pratico.
  rust = Rust
  kotlin = Kotlin
  swift = Swift
  go = Go
  python = Python
  csharp = C#
  status_shipped = Disponibile
  status_planned = Pianificato
}

web {
  kicker = SvelteKit
  title = SvelteKit localizzato senza cablaggio i18n manuale
  intro = Write normal SvelteKit routes and generated message calls. Linguini keeps the active locale and updates messages reactively. Generated message signatures let TypeScript report invalid arguments when the app runs type checking.
  routing = Usa normali link interni; l'adapter runtime SvelteKit gestisce gli URL localizzati.
  cookie = Configura cookie e storage del browser tramite la policy runtime dell'applicazione.
  fallback = Le traduzioni mancanti vengono risolte per messaggio durante il build.
  reactivity = Il cambio di locale prepara i messaggi necessari prima di aggiornare l'interfaccia reattiva.
  links = Alcuni link possono mantenere l'URL originale quando non vanno localizzati.
}

playground {
  kicker = Playground live
  title = Cambia count, fruit, size, amount, date o locale.
  count_label = Quantità
  fruit_label = Frutta
  fruit_apple_label = mela
  fruit_pear_label = pera
  fruit_orange_label = arancia
  size_label = Dimensione
  size_small_label = piccolo
  size_big_label = grande
  amount_label = Importo
  date_label = Data
  localized_path_label = Route localizzata
  cookie_label = Cookie
  route_label = Prefisso route
  sentence = {Delivered(count, fruit.Gender)} {count} {SizeAdj(size, count, fruit.Gender)} {fruit.nom(count)}. Totale {amount @currency(code = "EUR")}; data {date}.
  cart_summary = Il carrello ha {count} {fruit.nom(count)}
  number_format = Formato numero: {value}
  currency_format = Formato valuta: {amount @currency(code = "EUR")}
  date_format = Formato data: {date}
  override_format = Locale override: {amount @number} / {date @date(style = "long")}

  size_line = {size_form_label}: {SizeWord(size)}
}
