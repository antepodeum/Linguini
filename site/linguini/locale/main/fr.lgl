
enum Gender { male, female, neuter, other }

impl Fruit {
  apple {
    Gender = neuter
    emoji = 🍎

    form nom(Plural) {
      one => pomme
      _   => pommes
    }
  }

  pear {
    Gender = female
    emoji = 🍐

    form nom(Plural) {
      one => poire
      _   => poires
    }
  }

  orange {
    Gender = male
    emoji = 🍊

    form nom(Plural) {
      one => orange
      _   => oranges
    }
  }
}

form SizeAdj(Size, Plural, Gender) {
  small {
    one {
      male   => petit
      female => petite
      neuter => petit
      _      => petit
    }
    _ {
      male   => petits
      female => petites
      neuter => petits
      _      => petits
    }
  }
  big {
    one {
      male   => grand
      female => grande
      neuter => grand
      _      => grand
    }
    _ {
      male   => grands
      female => grandes
      neuter => grands
      _      => grands
    }
  }
  _ => normaux
}

form SizeWord(Size) {
  small => petit
  big   => grand
}

form Delivered(Plural, Gender) {
  one {
    _ => Livré
  }
  _ => Livrés
}

let size_form_label = Forme taille

nav {
  why = Pourquoi
  language = Langue
  codegen = Codegen
  web = Web
  locale_label = Langue
}

hero {
  eyebrow = Localisation typée pour équipes produit
  title = Linguini
  tagline = L'internationalisation pour le reste d'entre nous
  copy = Localisation typée avec messages et formatage CLDR compilés, plus des adaptateurs web et framework réutilisables.
  term = /lɪŋˈɡwiːni/
  term_kind = NOM
  term_hint = longs rubans de pâtes étroits
  intro = Linguini transforme des fichiers de locale liés au schéma en code généré typé. Avant la génération, check/build signalent les implémentations manquantes et valident les usages pris en charge des formatteurs, ainsi que les appels et branches de dispatch que l'analyseur peut résoudre.
  trait_typed = Typé
  trait_compiled = Compilé
  trait_native = Natif
  primary_cta = Lire la doc
  secondary_cta = Voir GitHub
}

codegen {
  kicker = Génération de code
  title = Un schéma, JavaScript avec des types TypeScript
  intro = Linguini analyse les contrats .lgs et la logique .lgl, puis compile des modules de messages avec formatage CLDR spécialisé et sélecteurs de pluriel.
  ts_title = JavaScript + .d.ts
  ts_desc = ESM et .d.ts générés pour TypeScript strict ; Vite sélectionne les messages et dépendances utilisés par chaque page.
  svelte_title = Svelte 5 + SvelteKit
  svelte_desc = État Svelte réutilisable et hooks de requête SvelteKit ; routage et persistance configurés dans le code de l'application.
  planned_title = Cibles prévues
  planned_intro = La feuille de route est volontairement large: Linguini vise tous les runtimes, langages et frameworks web pratiques.
  rust = Rust
  kotlin = Kotlin
  swift = Swift
  go = Go
  python = Python
  csharp = C#
  status_shipped = Disponible
  status_planned = Prévu
}

web {
  kicker = SvelteKit
  title = SvelteKit localisé sans câblage i18n manuel
  intro = Write normal SvelteKit routes and generated message calls. Linguini keeps the active locale and updates messages reactively. Generated message signatures let TypeScript report invalid arguments when the app runs type checking.
  routing = Utilisez des liens internes ordinaires ; l'adaptateur runtime SvelteKit traite les URL localisées.
  cookie = Configurez cookies et stockage du navigateur dans la politique runtime de l'application.
  fallback = Les traductions manquantes sont résolues message par message lors du build.
  reactivity = Le changement de locale prépare les messages nécessaires avant de mettre à jour l'interface réactive.
  links = Certains liens peuvent garder leur URL d'origine quand la localisation n'est pas voulue.
}

playground {
  kicker = Playground live
  title = Change count, fruit, size, amount, date ou locale.
  count_label = Quantité
  fruit_label = Fruit
  fruit_apple_label = pomme
  fruit_pear_label = poire
  fruit_orange_label = orange
  size_label = Taille
  size_small_label = petit
  size_big_label = grand
  amount_label = Montant
  date_label = Date
  localized_path_label = Route localisée
  cookie_label = Cookie
  route_label = Préfixe route
  sentence = {Delivered(count, fruit.Gender)} {count} {SizeAdj(size, count, fruit.Gender)} {fruit.nom(count)}. Total {amount @currency(code = "EUR")}; date {date}.
  cart_summary = Le panier contient {count} {fruit.nom(count)}
  number_format = Format nombre: {value}
  currency_format = Format devise: {amount @currency(code = "EUR")}
  date_format = Format date: {date}
  override_format = Locale override: {amount @number} / {date @date(style = "long")}

  size_line = {size_form_label}: {SizeWord(size)}
}
