
enum Gender { male, female, neuter, other }

impl Fruit {
  apple {
    Gender = neuter
    emoji = 🍎

    form nom(Plural) {
      one => maçã
      _   => maçãs
    }
  }

  pear {
    Gender = female
    emoji = 🍐

    form nom(Plural) {
      one => pera
      _   => peras
    }
  }

  orange {
    Gender = male
    emoji = 🍊

    form nom(Plural) {
      one => laranja
      _   => laranjas
    }
  }
}

form SizeAdj(Size, Plural, Gender) {
  small {
    one {
      male   => pequeno
      female => pequena
      neuter => pequeno
      _      => pequeno
    }
    _ {
      male   => pequenos
      female => pequenas
      neuter => pequenos
      _      => pequenos
    }
  }
  big {
    one {
      male   => grande
      female => grande
      neuter => grande
      _      => grande
    }
    _ {
      male   => grandes
      female => grandes
      neuter => grandes
      _      => grandes
    }
  }
  _ => normais
}

form SizeWord(Size) {
  small => pequeno
  big   => grande
}

form Delivered(Plural, Gender) {
  one {
    _ => Entregue
  }
  _ => Entregues
}

let size_form_label = Forma de tamanho

nav {
  why = Por quê
  language = Idioma
  codegen = Codegen
  web = Web
  locale_label = Idioma
}

hero {
  eyebrow = Localização tipada para times de produto
  title = Linguini
  tagline = Internacionalização para todos nós
  copy = Localização tipada com mensagens e formatação CLDR compiladas e adaptadores web e de frameworks reutilizáveis.
  term = /lɪŋˈɡwiːni/
  term_kind = NOME
  term_hint = tiras longas e estreitas de massa
  intro = O Linguini transforma arquivos de locale vinculados ao schema em código gerado tipado. Antes da geração, check/build informam implementações ausentes e validam usos compatíveis de formatadores, chamadas de locale e ramos de dispatch que o analisador consegue resolver.
  trait_typed = Tipado
  trait_compiled = Compilado
  trait_native = Nativo
  primary_cta = Ler a documentação
  secondary_cta = Ver no GitHub
}

codegen {
  kicker = Geração de código
  title = Um esquema, JavaScript com tipos TypeScript
  intro = O Linguini analisa contratos .lgs e lógica .lgl e compila módulos de mensagens com formatadores CLDR especializados e seletores de plural.
  ts_title = JavaScript + .d.ts
  ts_desc = ESM e .d.ts gerados para TypeScript estrito; o Vite seleciona as mensagens e dependências usadas em cada página.
  svelte_title = Svelte 5 + SvelteKit
  svelte_desc = Estado Svelte reutilizável e hooks de requisições SvelteKit; rotas e persistência são configuradas no código da aplicação.
  planned_title = Alvos planejados
  planned_intro = O roadmap é amplo de propósito: Linguini pretende cobrir todos os runtimes, linguagens e frameworks web práticos.
  rust = Rust
  kotlin = Kotlin
  swift = Swift
  go = Go
  python = Python
  csharp = C#
  status_shipped = Disponível
  status_planned = Planejado
}

web {
  kicker = SvelteKit
  title = SvelteKit localizado sem ligação i18n manual
  intro = Write normal SvelteKit routes and generated message calls. Linguini keeps the active locale and updates messages reactively. Generated message signatures let TypeScript report invalid arguments when the app runs type checking.
  routing = Use links internos normais; o adaptador runtime SvelteKit trata as URLs localizadas.
  cookie = Configure cookies e armazenamento do navegador pela política runtime da aplicação.
  fallback = As traduções ausentes são resolvidas por mensagem durante o build.
  reactivity = A troca de locale prepara as mensagens necessárias antes de atualizar a interface reativa.
  links = Alguns links podem manter a URL original quando não devem ser localizados.
}

playground {
  kicker = Playground ao vivo
  title = Altere count, fruit, size, amount, date ou locale.
  count_label = Quantidade
  fruit_label = Fruta
  fruit_apple_label = maçã
  fruit_pear_label = pera
  fruit_orange_label = laranja
  size_label = Tamanho
  size_small_label = pequeno
  size_big_label = grande
  amount_label = Valor
  date_label = Data
  localized_path_label = Rota localizada
  cookie_label = Cookie
  route_label = Prefixo da rota
  sentence = {Delivered(count, fruit.Gender)} {count} {SizeAdj(size, count, fruit.Gender)} {fruit.nom(count)}. Total {amount @currency(code = "BRL")}; data {date}.
  cart_summary = O carrinho tem {count} {fruit.nom(count)}
  number_format = Formato numérico: {value}
  currency_format = Formato de moeda: {amount @currency(code = "BRL")}
  date_format = Formato de data: {date}
  override_format = Locale override: {amount @number} / {date @date(style = "long")}

  size_line = {size_form_label}: {SizeWord(size)}
}
