
enum Gender { male, female, neuter, other }

impl Fruit {
  apple {
    Gender = neuter
    emoji = 🍎

    form nom(Plural) {
      one => Apfel
      _   => Äpfel
    }
  }

  pear {
    Gender = female
    emoji = 🍐

    form nom(Plural) {
      one => Birne
      _   => Birnen
    }
  }

  orange {
    Gender = male
    emoji = 🍊

    form nom(Plural) {
      one => Orange
      _   => Orangen
    }
  }
}

form SizeAdj(Size, Plural, Gender) {
  small {
    one {
      male   => kleiner
      female => kleine
      neuter => kleines
      _      => kleiner
    }
    _ => kleine
  }
  big {
    one {
      male   => großer
      female => große
      neuter => großes
      _      => großer
    }
    _ => große
  }
  _ => normale
}

form SizeWord(Size) {
  small => klein
  big   => groß
}

let size_form_label = Größenform

nav {
  why = Warum
  language = Sprache
  codegen = Codegen
  web = Web
  locale_label = Sprache
}

hero {
  eyebrow = Typisierte Lokalisierung für Produktteams
  title = Linguini
  tagline = Internationalisierung für uns alle
  copy = Typisierte Lokalisierung mit kompilierten Nachrichten und CLDR-Formatierung sowie wiederverwendbaren Web- und Framework-Adaptern.
  term = /lɪŋˈɡwiːni/
  term_kind = NOMEN
  term_hint = lange, schmale Pastabänder
  intro = Linguini macht aus schema-gebundenen Locale-Dateien typisierten generierten Code. Vor der Generierung melden check/build fehlende Implementierungen und prüfen unterstützte Formatter-Aufrufe sowie Locale-Aufrufe und Dispatch-Zweige, die der Analyzer auflösen kann.
  trait_typed = Typisiert
  trait_compiled = Kompiliert
  trait_native = Nativ
  primary_cta = Docs lesen
  secondary_cta = GitHub ansehen
}

codegen {
  kicker = Codegenerierung
  title = Ein Schema, JavaScript mit TypeScript-Typen
  intro = Linguini analysiert .lgs-Verträge und .lgl-Locale-Logik und kompiliert Nachrichtenmodule mit spezialisierten CLDR-Formatierern und Plural-Selektoren.
  ts_title = JavaScript + .d.ts
  ts_desc = Generierte ESM- und .d.ts-Dateien für striktes TypeScript; Vite wählt die verwendeten Nachrichten und Abhängigkeiten pro Seite.
  svelte_title = Svelte 5 + SvelteKit
  svelte_desc = Wiederverwendbarer Svelte-Zustand und SvelteKit-Request-Hooks; Routing und Persistenz werden im Anwendungscode konfiguriert.
  planned_title = Geplante Targets
  planned_intro = Die Roadmap ist bewusst breit: Linguini soll alle praktischen Runtimes, Sprachen und Web-Frameworks erreichen.
  rust = Rust
  kotlin = Kotlin
  swift = Swift
  go = Go
  python = Python
  csharp = C#
  status_shipped = Verfügbar
  status_planned = Geplant
}

web {
  kicker = SvelteKit
  title = Lokalisierter SvelteKit ohne handgeschriebene i18n-Verdrahtung
  intro = Write normal SvelteKit routes and generated message calls. Linguini keeps the active locale and updates messages reactively. Generated message signatures let TypeScript report invalid arguments when the app runs type checking.
  routing = Verwenden Sie normale interne Links; der SvelteKit-Runtime-Adapter verarbeitet lokalisierte URLs.
  cookie = Cookies und Browser-Speicher werden über die Runtime-Konfiguration der Anwendung eingerichtet.
  fallback = Fehlende Übersetzungen werden beim Build pro Nachricht aufgelöst.
  reactivity = Beim Locale-Wechsel werden die benötigten Nachrichten vor der Aktualisierung der reaktiven UI vorbereitet.
  links = Einzelne Links können ihre ursprüngliche URL behalten, wenn keine Lokalisierung gewünscht ist.
}

playground {
  kicker = Live Playground
  title = Ändere count, fruit, size, amount, date oder locale.
  count_label = Anzahl
  fruit_label = Frucht
  fruit_apple_label = Apfel
  fruit_pear_label = Birne
  fruit_orange_label = Orange
  size_label = Größe
  size_small_label = klein
  size_big_label = groß
  amount_label = Betrag
  date_label = Datum
  localized_path_label = Lokalisierte Route
  cookie_label = Cookie
  route_label = Route-Präfix
  sentence = Geliefert {count} {SizeAdj(size, count, fruit.Gender)} {fruit.nom(count)}. Summe {amount @currency(code = "EUR")}; Datum {date}.
  cart_summary = Warenkorb enthält {count} {fruit.nom(count)}
  number_format = Zahlenformat: {value}
  currency_format = Währungsformat: {amount @currency(code = "EUR")}
  date_format = Datumsformat: {date}
  override_format = Locale override: {amount @number} / {date @date(style = "long")}

  size_line = {size_form_label}: {SizeWord(size)}
}
