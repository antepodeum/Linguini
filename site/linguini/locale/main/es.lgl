
enum Gender { male, female, neuter, other }

impl Fruit {
  apple {
    Gender = neuter
    emoji = 🍎

    form nom(Plural) {
      one => manzana
      _   => manzanas
    }
  }

  pear {
    Gender = female
    emoji = 🍐

    form nom(Plural) {
      one => pera
      _   => peras
    }
  }

  orange {
    Gender = male
    emoji = 🍊

    form nom(Plural) {
      one => naranja
      _   => naranjas
    }
  }
}

form SizeAdj(Size, Plural, Gender) {
  small {
    one {
      male   => pequeño
      female => pequeña
      neuter => pequeño
      _      => pequeño
    }
    _ {
      male   => pequeños
      female => pequeñas
      neuter => pequeños
      _      => pequeños
    }
  }
  big {
    one {
      male   => grande
      female => grande
      neuter => grande
      _      => grande
    }
    _ {
      male   => grandes
      female => grandes
      neuter => grandes
      _      => grandes
    }
  }
  _ => normales
}

form SizeWord(Size) {
  small => pequeño
  big   => grande
}

form Delivered(Plural, Gender) {
  one {
    _ => Entregado
  }
  _ => Entregados
}

let size_form_label = Forma de tamaño

nav {
  why = Por qué
  language = Idioma
  codegen = Codegen
  web = Web
  locale_label = Idioma
}

hero {
  eyebrow = Localización tipada para equipos de producto
  title = Linguini
  tagline = Internacionalización para el resto de nosotros
  copy = Localización tipada con mensajes y formato CLDR compilados, además de adaptadores web y de frameworks reutilizables.
  term = /lɪŋˈɡwiːni/
  term_kind = SUST.
  term_hint = tiras largas y estrechas de pasta
  intro = Linguini convierte archivos de locale vinculados al schema en código generado tipado. Antes de generar, check/build informan implementaciones ausentes y validan usos compatibles de formateadores, llamadas de locale y ramas de dispatch que el analizador puede resolver.
  trait_typed = Tipado
  trait_compiled = Compilado
  trait_native = Nativo
  primary_cta = Leer docs
  secondary_cta = Ver GitHub
}

codegen {
  kicker = Generación de código
  title = Un esquema, JavaScript con tipos TypeScript
  intro = Linguini analiza contratos .lgs y lógica .lgl, y compila módulos de mensajes con formato CLDR especializado y selectores de plural.
  ts_title = JavaScript + .d.ts
  ts_desc = ESM y .d.ts generados para TypeScript estricto; Vite selecciona los mensajes y dependencias usados por cada página.
  svelte_title = Svelte 5 + SvelteKit
  svelte_desc = Estado Svelte reutilizable y hooks de solicitudes SvelteKit; rutas y persistencia se configuran en el código de la aplicación.
  planned_title = Targets planificados
  planned_intro = La hoja de ruta es amplia a propósito: Linguini planea cubrir todo runtime, lenguaje y framework web práctico.
  rust = Rust
  kotlin = Kotlin
  swift = Swift
  go = Go
  python = Python
  csharp = C#
  status_shipped = Disponible
  status_planned = Planificado
}

web {
  kicker = SvelteKit
  title = SvelteKit localizado sin cableado i18n manual
  intro = Write normal SvelteKit routes and generated message calls. Linguini keeps the active locale and updates messages reactively. Generated message signatures let TypeScript report invalid arguments when the app runs type checking.
  routing = Usa enlaces internos normales; el adaptador runtime de SvelteKit procesa las URL localizadas.
  cookie = Configura cookies y almacenamiento del navegador mediante la política runtime de la aplicación.
  fallback = Las traducciones ausentes se resuelven por mensaje durante el build.
  reactivity = El cambio de locale prepara los mensajes necesarios antes de actualizar la interfaz reactiva.
  links = Algunos enlaces pueden conservar su URL original cuando no deben localizarse.
}

playground {
  kicker = Playground en vivo
  title = Cambia count, fruit, size, amount, date o locale.
  count_label = Cantidad
  fruit_label = Fruta
  fruit_apple_label = manzana
  fruit_pear_label = pera
  fruit_orange_label = naranja
  size_label = Tamaño
  size_small_label = pequeño
  size_big_label = grande
  amount_label = Importe
  date_label = Fecha
  localized_path_label = Ruta localizada
  cookie_label = Cookie
  route_label = Prefijo de ruta
  sentence = {Delivered(count, fruit.Gender)} {count} {SizeAdj(size, count, fruit.Gender)} {fruit.nom(count)}. Total {amount @currency(code = "EUR")}; fecha {date}.
  cart_summary = El carrito tiene {count} {fruit.nom(count)}
  number_format = Formato numérico: {value}
  currency_format = Formato moneda: {amount @currency(code = "EUR")}
  date_format = Formato fecha: {date}
  override_format = Locale override: {amount @number} / {date @date(style = "long")}

  size_line = {size_form_label}: {SizeWord(size)}
}
