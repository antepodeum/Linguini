{
  "name": "@antepod/linguini-site",
  "private": true,
  "version": "0.1.0-alpha.4",
  "type": "module",
  "packageManager": "pnpm@11.1.0",
  "scripts": {
    "dev": "vite dev",
    "linguini:build": "node scripts/restore-linguini-output.mjs",
    "linguini:refresh": "cargo run --locked -p linguini-cli -- build && pnpm linguini:package",
    "linguini:package": "node scripts/package-linguini-output.mjs",
    "linguini:verify": "pnpm linguini:build && pnpm test",
    "build:generated": "vite build",
    "build": "pnpm linguini:build && pnpm build:generated",
    "test:production": "pnpm linguini:build && pnpm build:generated && node scripts/production-graph.test.mjs",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "test": "node --test scripts/generated-runtime.test.mjs scripts/packaged-output.test.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "dependencies": {
    "@antepod/linguini-vite": "file:../plugins/vite",
    "@fontsource-variable/newsreader": "^5.2.8",
    "@fontsource-variable/work-sans": "^5.2.8",
    "@iconify-svelte/skill-icons": "^1.0.3",
    "@lucide/svelte": "^1.0.1",
    "clsx": "^2.1.1",
    "shiki": "^4.0.2",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/node": "^24.10.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.2",
    "vite": "^8.0.7"
  }
}
