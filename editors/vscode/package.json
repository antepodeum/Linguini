{
  "name": "linguini-vscode",
  "displayName": "Linguini",
  "description": "VS Code language support for Linguini schema and locale files.",
  "icon": "assets/icon.png",
  "version": "0.1.0-alpha.4",
  "publisher": "antepod",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/antepodeum/Linguini.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:linguini-schema",
    "onLanguage:linguini-locale",
    "workspaceContains:**/linguini.toml"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "test": "npm run compile && node --test out/restart.test.js out/server-resolution.test.js",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.js --sourcemap --sources-content=false",
    "test:integration": "npm run bundle && node ./scripts/run-integration-tests.js",
    "package:vsix": "node ./scripts/package-vsix.js",
    "watch": "tsc -watch -p ./",
    "open:dev": "npm run compile && code --extensionDevelopmentPath=. ./sample-workspace",
    "audit:prod": "npm audit --omit=dev",
    "vscode:prepublish": "npm run compile && npm test",
    "check": "npm run compile && npm audit --audit-level=moderate",
    "dev:host": "npm run compile && node ./scripts/open-extension-host.js"
  },
  "contributes": {
    "languages": [
      {
        "id": "linguini-schema",
        "aliases": [
          "Linguini Schema",
          "linguini-schema"
        ],
        "extensions": [
          ".lgs"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "linguini-locale",
        "aliases": [
          "Linguini Locale",
          "linguini-locale"
        ],
        "extensions": [
          ".lgl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "linguini-schema",
        "scopeName": "source.linguini.schema",
        "path": "./syntaxes/linguini-schema.tmLanguage.json"
      },
      {
        "language": "linguini-locale",
        "scopeName": "source.linguini.locale",
        "path": "./syntaxes/linguini-locale.tmLanguage.json"
      },
      {
        "scopeName": "markdown.linguini.schema.codeblock",
        "path": "./syntaxes/markdown-linguini-schema.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ]
      },
      {
        "scopeName": "markdown.linguini.locale.codeblock",
        "path": "./syntaxes/markdown-linguini-locale.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ]
      }
    ],
    "configuration": {
      "title": "Linguini",
      "properties": {
        "linguini.server.path": {
          "type": "string",
          "default": "",
          "description": "Optional explicit Linguini CLI path. Resolution otherwise checks an enabled workspace CLI, the bundled platform binary, then PATH."
        },
        "linguini.server.useWorkspaceCli": {
          "type": "boolean",
          "default": false,
          "description": "Prefer a project-pinned `node_modules/.bin/linguini` in a single-folder workspace."
        },
        "linguini.server.args": {
          "type": "array",
          "default": [
            "lsp"
          ],
          "items": {
            "type": "string"
          },
          "description": "Arguments passed to the Linguini server. `${workspaceFolder}` is supported only in a single-folder workspace."
        },
        "linguini.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace communication between VS Code and the Linguini language server."
        },
        "linguini.semanticHighlighting.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable semantic highlighting from `linguini lsp`."
        }
      }
    },
    "configurationDefaults": {
      "[linguini-schema]": {
        "editor.defaultFormatter": "antepod.linguini-vscode",
        "editor.semanticHighlighting.enabled": true
      },
      "[linguini-locale]": {
        "editor.defaultFormatter": "antepod.linguini-vscode",
        "editor.semanticHighlighting.enabled": true
      }
    },
    "semanticTokenScopes": [
      {
        "language": "linguini-schema",
        "scopes": {
          "enum": [
            "entity.name.type.enum.linguini"
          ],
          "enumMember": [
            "variable.other.enummember.linguini"
          ],
          "type": [
            "entity.name.type.linguini"
          ],
          "function": [
            "entity.name.function.linguini"
          ],
          "parameter": [
            "variable.parameter.linguini"
          ],
          "property": [
            "variable.other.member.linguini"
          ],
          "keyword": [
            "keyword.control.linguini"
          ]
        }
      },
      {
        "language": "linguini-locale",
        "scopes": {
          "enum": [
            "entity.name.type.enum.linguini"
          ],
          "enumMember": [
            "variable.other.enummember.linguini"
          ],
          "type": [
            "entity.name.type.linguini"
          ],
          "function": [
            "entity.name.function.linguini"
          ],
          "parameter": [
            "variable.parameter.linguini"
          ],
          "property": [
            "variable.other.member.linguini"
          ],
          "keyword": [
            "keyword.control.linguini"
          ],
          "string": [
            "string.unquoted.linguini"
          ]
        }
      }
    ],
    "commands": [
      {
        "command": "linguini.restartServer",
        "title": "Linguini: Restart Language Server"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "10.1.0"
  },
  "devDependencies": {
    "@types/node": "20.14.2",
    "@types/vscode": "1.120.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.1",
    "ovsx": "1.0.2",
    "typescript": "5.9.3"
  }
}
