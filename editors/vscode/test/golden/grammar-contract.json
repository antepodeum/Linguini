{
  "languageConfiguration": {
    "comments": {
      "lineComment": "//"
    },
    "brackets": [
      [
        "{",
        "}"
      ],
      [
        "(",
        ")"
      ]
    ],
    "autoClosingPairs": [
      {
        "open": "{",
        "close": "}"
      },
      {
        "open": "(",
        "close": ")"
      },
      {
        "open": "\"",
        "close": "\"",
        "notIn": [
          "string",
          "comment"
        ]
      }
    ],
    "surroundingPairs": [
      {
        "open": "{",
        "close": "}"
      },
      {
        "open": "(",
        "close": ")"
      },
      {
        "open": "\"",
        "close": "\""
      }
    ],
    "folding": {
      "markers": {
        "start": "^\\s*//\\s*#?region\\b",
        "end": "^\\s*//\\s*#?endregion\\b"
      }
    },
    "wordPattern": "(-?\\d*\\.\\d\\w*)|([^`~!#$%^&*()+\\=\\[\\]{}\\\\|;:'\",.<>/?\\s]+)"
  },
  "manifest": {
    "languages": [
      {
        "id": "linguini-schema",
        "aliases": [
          "Linguini Schema",
          "linguini-schema"
        ],
        "extensions": [
          ".lgs"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "linguini-locale",
        "aliases": [
          "Linguini Locale",
          "linguini-locale"
        ],
        "extensions": [
          ".lgl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "linguini-schema",
        "scopeName": "source.linguini.schema",
        "path": "./syntaxes/linguini-schema.tmLanguage.json"
      },
      {
        "language": "linguini-locale",
        "scopeName": "source.linguini.locale",
        "path": "./syntaxes/linguini-locale.tmLanguage.json"
      },
      {
        "scopeName": "markdown.linguini.schema.codeblock",
        "path": "./syntaxes/markdown-linguini-schema.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ]
      },
      {
        "scopeName": "markdown.linguini.locale.codeblock",
        "path": "./syntaxes/markdown-linguini-locale.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ]
      }
    ]
  },
