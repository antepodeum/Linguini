{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linguini.dev/schema/linguini.schema.json",
  "title": "Linguini configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "paths"],
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "default_locale", "locales"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "default_locale": { "$ref": "#/$defs/locale" },
        "locales": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/locale" } }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "locale"],
      "properties": {
        "schema": { "$ref": "#/$defs/projectPath" },
        "locale": { "$ref": "#/$defs/projectPath" }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "out": { "$ref": "#/$defs/projectPath", "default": "src/generated/linguini" },
            "declaration": { "type": "boolean", "default": true },
            "gitignore": { "type": "boolean", "default": true },
            "tree_shaking": { "type": "boolean", "default": false },
            "messages": { "type": "array", "items": { "type": "string", "minLength": 1 }, "default": [] },
            "framework": { "enum": ["svelte", "sveltekit"] },
            "bundler": { "$ref": "#/$defs/bundler" }
          }
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unused_messages": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sources": { "$ref": "#/$defs/pathList" },
            "exclude": { "$ref": "#/$defs/pathList" },
            "ignore": { "type": "array", "items": { "type": "string", "minLength": 1 }, "default": [] }
          }
        }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "routing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "locale_prefix": { "enum": ["always", "except-default", "never"], "default": "except-default" },
            "canonical": { "enum": ["redirect", "preserve"], "default": "redirect" }
          }
        },
        "locale": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sources": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["path", "cookie", "local-storage", "accept-language"] }
            }
          }
        },
        "cookie": { "$ref": "#/$defs/cookie" },
        "local_storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "key": { "type": "string", "minLength": 1 } }
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "mode": { "enum": ["transform", "runtime", "manual"], "default": "transform" } }
        },
        "routes": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 }, "default": [] } }
        },
        "switch_route": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string", "default": "/_linguini/locale/{locale}" },
            "return_query": { "type": "string", "minLength": 1, "default": "return" },
            "status": { "type": "integer", "minimum": 300, "maximum": 399, "default": 303 }
          }
        }
      }
    }
  },
  "$defs": {
    "locale": { "type": "string", "minLength": 2 },
    "projectPath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
    "pathList": { "type": "array", "items": { "$ref": "#/$defs/projectPath" }, "default": [] },
    "bundler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sources": { "$ref": "#/$defs/pathList" },
        "exclude": { "$ref": "#/$defs/pathList" },
        "locale_loading": { "enum": ["eager", "dynamic"], "default": "eager" },
        "dynamic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["error", "bundle"], "default": "error" },
            "allow": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 }, "default": [] }
          }
        }
      }
    },
    "cookie": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "default": "auto" },
        "domain": { "type": "string", "minLength": 1 },
        "max_age": { "type": "string", "pattern": "^[0-9]+[smhdw]?$", "default": "365d" },
        "same_site": { "enum": ["lax", "strict", "none"], "default": "lax" },
        "secure": { "oneOf": [{ "type": "boolean" }, { "const": "auto" }], "default": "auto" },
        "http_only": { "type": "boolean", "default": false }
      }
    }
  }
}
