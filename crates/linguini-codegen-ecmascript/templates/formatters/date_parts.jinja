{% macro field(part, clock) -%}
{% if part.field == "y" %}{% if part.width == 2 %}padNumber(year % 100, 2){% elif part.width > 2 %}padNumber(year, {{ part.width }}){% else %}String(year){% endif %}
{%- elif part.field in ["M", "L"] %}{% if part.width >= 3 %}{{ part.table }}[date.getUTCMonth()]{% elif part.width == 2 %}padNumber(date.getUTCMonth() + 1, 2){% else %}String(date.getUTCMonth() + 1){% endif %}
{%- elif part.field in ["E", "e", "c"] and part.table is not none %}{{ part.table }}[date.getUTCDay()]
{%- elif part.field == "d" %}{% if part.width == 2 %}padNumber(date.getUTCDate(), 2){% else %}String(date.getUTCDate()){% endif %}
{%- elif part.field in ["H", "h", "K", "k", "m", "s"] %}{% if part.width == 2 %}padNumber({% else %}String({% endif %}{% if part.field == "H" %}{{ "hours" if clock.hours else "date.getUTCHours()" }}{% elif part.field == "h" %}{{ "hours" if clock.hours else "date.getUTCHours()" }} % 12 || 12{% elif part.field == "K" %}{{ "hours" if clock.hours else "date.getUTCHours()" }} % 12{% elif part.field == "k" %}{{ "hours" if clock.hours else "date.getUTCHours()" }} || 24{% elif part.field == "m" %}{{ "minutes" if clock.minutes else "date.getUTCMinutes()" }}{% else %}{{ "seconds" if clock.seconds else "date.getUTCSeconds()" }}{% endif %}{% if part.width == 2 %}, 2{% endif %})
{%- elif part.field == "S" %}padNumber({{ "milliseconds" if clock.milliseconds else "date.getUTCMilliseconds()" }}, 3){% if part.width > 3 %}.padEnd({{ part.width }}, "0"){% endif %}{% if part.width != 3 %}.slice(0, {{ part.width }}){% endif %}
{%- elif part.period is not none %}{{ part.period.binding }}
{%- elif part.field in ["a", "b", "B"] %}({{ "hours" if clock.hours else "date.getUTCHours()" }} < 12 ? {{ part.am|js }} : {{ part.pm|js }})
{%- elif part.field == "G" %}({{ "extendedYear" if clock.year else "date.getUTCFullYear()" }} > 0 ? {{ part.ad|js }} : {{ part.bc|js }})
{%- else %}{{ unsupported_date_field }}{% endif %}
{%- endmacro %}
{% macro expression(parts, digits, clock) -%}
{% for part in parts %}{% if part.kind == "literal" %}{{ part.value|js }}{% else %}{% if digits != "0123456789" and part.numeric %}localizeGeneratedDigits({% endif %}{{ field(part, clock) }}{% if digits != "0123456789" and part.numeric %}, {{ digits|js }}){% endif %}{% endif %}{{ " + " if not loop.last }}{% else %}""{% endfor %}
{%- endmacro %}
