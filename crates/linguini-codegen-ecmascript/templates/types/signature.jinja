{%- macro positional(parameters) -%}
{%- for parameter in parameters -%}{{ parameter.binding }}: {{ parameter.ty }}{{ ", " if not loop.last }}{%- endfor -%}
{%- endmacro -%}
{%- macro named(parameters) -%}{ {% for parameter in parameters %}{{ parameter.property }}: {{ parameter.ty }}{{ "; " if not loop.last }}{% endfor %} }{%- endmacro -%}
{%- if kind == "positional" -%}{{ positional(parameters) }}
{%- elif kind == "named" -%}{{ named(parameters) }}
{%- elif kind == "named_argument" -%}args: {{ named(parameters) }}
{%- elif kind == "rest" -%}...{{ name }}
{%- elif kind == "callable" -%}
{%- if not parameters -%}string
{%- elif jsdoc -%}(({{ positional(parameters) }}) => string) & ((args: {{ named(parameters) }}) => string)
{%- else -%}{ ({{ positional(parameters) }}): string; (args: {{ named(parameters) }}): string; }
{%- endif -%}
{%- endif -%}
