function groupIntegerDigits(integer, primaryGroupSize, secondaryGroupSize, groupSymbol) {
{% endif %}  if (!primaryGroupSize || integer.length <= primaryGroupSize) return integer;
{% if ts %}  const groups: string[] = [];
{% else %}  /** @type {string[]} */
