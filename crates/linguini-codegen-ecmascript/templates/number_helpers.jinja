{% if ts %}function padGeneratedNumber(
  prefix: string,
  number: string,
  suffix: string,
  character: string | undefined,
  width: number | undefined,
  position: number | undefined,
): string {
{% else %}/**
 * @param {string} prefix
 * @param {string} number
 * @param {string} suffix
 * @param {string | undefined} character
 * @param {number | undefined} width
 * @param {number | undefined} position
 * @returns {string}
 */
function padGeneratedNumber(prefix, number, suffix, character, width, position) {
{% endif %}  if (character === undefined || width === undefined || position === undefined) {
    return `${prefix}${number}${suffix}`;
