/**
 * @typedef {object} __lgl_Decimal
 * @property {boolean} negative
 * @property {string} integer
 * @property {string} fraction
 */
const MAX_GENERATED_DECIMAL_DIGITS = {{ max_decimal_digits }};

/**
 * @param {__lgl_Numeric} value
 * @returns {__lgl_Decimal | undefined}
 */
function parseGeneratedDecimal(value) {
  if (typeof value === "number" && !Number.isFinite(value)) return undefined;
  const source = String(value);
  if (typeof value === "bigint" || Number.isSafeInteger(value)) {
    const hasSign = source[0] === "-";
    const integer = hasSign ? source.slice(1) : source;
    if (integer.length > MAX_GENERATED_DECIMAL_DIGITS) throwInvalidNumber();
    return { negative: hasSign || (value === 0 && Object.is(value, -0)), integer, fraction: "" };
  }
  const match = /^([+-]?)(\d*)(?:\.(\d*))?(?:[eE]([+-]?\d+))?$/.exec(source);
  if (!match || (match[2] === "" && (match[3] ?? "") === "")) throwInvalidNumber();

  const whole = match[2];
  const fractional = match[3] ?? "";
  const exponent = Number(match[4] ?? "0");
  if (
    !Number.isSafeInteger(exponent) ||
    Math.abs(exponent) > MAX_GENERATED_DECIMAL_DIGITS ||
    (match[4]?.length ?? 0) > MAX_GENERATED_DECIMAL_DIGITS ||
    whole.length + fractional.length > MAX_GENERATED_DECIMAL_DIGITS
  ) {
    throwInvalidNumber();
  }

  const digits = `${whole}${fractional}` || "0";
  const decimalPosition = whole.length + exponent;
  const expandedLength = decimalPosition <= 0
    ? -decimalPosition + digits.length
    : Math.max(decimalPosition, digits.length);
  if (expandedLength > MAX_GENERATED_DECIMAL_DIGITS) throwInvalidNumber();

  /** @type {string} */
  let integer;
  /** @type {string} */
  let fraction;
  if (decimalPosition <= 0) {
    integer = "0";
    fraction = `${"0".repeat(-decimalPosition)}${digits}`;
  } else if (decimalPosition >= digits.length) {
    integer = `${digits}${"0".repeat(decimalPosition - digits.length)}`;
    fraction = "";
  } else {
    integer = digits.slice(0, decimalPosition);
    fraction = digits.slice(decimalPosition);
  }
  integer = integer.replace(/^0+(?=\d)/, "");
  fraction = fraction.replace(/0+$/, "");
  return {
    negative: match[1] === "-",
    integer,
    fraction,
  };
}

{% for plan in scale_plans %}/**
 * @param {__lgl_Decimal} decimal
 * @returns {__lgl_Decimal}
 */
function scaleBy{{ plan.scale }}(decimal) {
  const source = `${decimal.integer}${decimal.fraction}`;
  const decimalPosition = decimal.integer.length + {{ plan.scale_shift }};
  if (source.length + {{ plan.scale_shift }} > MAX_GENERATED_DECIMAL_DIGITS) throwInvalidNumber();
  const expanded = source.padEnd(decimalPosition, "0");
  const integer = expanded.slice(0, decimalPosition).replace(/^0+(?=\d)/, "") || "0";
  const fraction = expanded.slice(decimalPosition).replace(/0+$/, "");
  return { negative: decimal.negative, integer, fraction };
}

{% endfor %}{% for plan in scientific_plans %}/**
 * @param {__lgl_Decimal} decimal
 * @returns {__lgl_Decimal & {{ "{" }} exponent: number }}
 */
function {{ plan.scientific_helper }}(decimal) {
  if (decimal.integer === "0" && decimal.fraction === "") {
    return { negative: decimal.negative, integer: "0", fraction: "", exponent: 0 };
  }
  /** @type {string} */
  let source;
  /** @type {number} */
  let exponent;
  if (decimal.integer !== "0") {
    source = `${decimal.integer}${decimal.fraction}`;
    exponent = decimal.integer.length - 1;
  } else {
    const first = decimal.fraction.search(/[1-9]/);
    source = decimal.fraction.slice(first);
    exponent = -first - 1;
  }
{% if plan.scientific_exponent_step > 1 %}  const integerDigits = exponent - Math.floor(exponent / {{ plan.scientific_exponent_step }}) * {{ plan.scientific_exponent_step }} + 1;
  exponent -= integerDigits - 1;
{% elif plan.scientific_integer_digits > 1 %}  exponent -= {{ plan.scientific_integer_digits - 1 }};
{% endif %}  return {
    negative: decimal.negative,
    integer: {% if plan.scientific_exponent_step > 1 %}source.slice(0, integerDigits).padEnd(integerDigits, "0"){% elif plan.scientific_integer_digits > 1 %}source.slice(0, {{ plan.scientific_integer_digits }}).padEnd({{ plan.scientific_integer_digits }}, "0"){% else %}source[0]{% endif %},
    fraction: source.slice({% if plan.scientific_exponent_step > 1 %}integerDigits{% else %}{{ plan.scientific_integer_digits }}{% endif %}).replace(/0+$/, ""),
    exponent,
  };
}

{% endfor %}{% if scientific_shift %}/**
 * @param {__lgl_Decimal} decimal
 * @param {number} shift
 * @returns {__lgl_Decimal}
 */
function shiftScientificMantissa(decimal, shift) {
  const source = `${decimal.integer}${decimal.fraction}`;
  const decimalPosition = decimal.integer.length - shift;
  return {
    negative: decimal.negative,
    integer: decimalPosition > 0 ? source.slice(0, decimalPosition) : "0",
    fraction: decimalPosition > 0 ? source.slice(decimalPosition) : "0".repeat(-decimalPosition) + source,
  };
}

{% endif %}{% for entry in significant_plans %}{% set plan = entry.plan %}{% if entry.fixed_fraction is not none %}{% with fraction_digits=entry.fixed_fraction, increment="1", name=entry.name, normalized_significant=true %}{% include "number_rounding" %}{% endwith %}
{% else %}/**
 * @param {__lgl_Decimal} decimal
 * @returns {{ "{{" }} integer: string, fraction: string }}
 */
function roundTo{{ plan.max_significant }}SignificantDigits(decimal) {
{% if entry.integer_width is not none %}  if (decimal.integer === "0") return { integer: "0", fraction: "" };
{% if entry.integer_width <= plan.max_significant %}  return roundGeneratedFraction(decimal, {% if entry.integer_width == 1 %}{{ plan.max_significant - 1 }}{% else %}{{ plan.max_significant }} - decimal.integer.length{% endif %});
{% else %}  const cut = {{ plan.max_significant }};
{% endif %}{% else %}  const combined = `${decimal.integer}${decimal.fraction}`;
  const first = combined.search(/[1-9]/);
  if (first < 0) return { integer: "0", fraction: "" };
  const cut = first + {{ plan.max_significant }};
{% endif %}{% if entry.integer_width is none or entry.integer_width > plan.max_significant %}  if (cut >= decimal.integer.length) {
    return roundGeneratedFraction(decimal, cut - decimal.integer.length);
  }

  const kept = decimal.integer.slice(0, cut);
  const rounded = BigInt(kept) + (decimal.integer[cut] >= "5" ? 1n : 0n);
  return {
    integer: `${rounded}${"0".repeat(decimal.integer.length - cut)}`,
    fraction: "",
  };
{% endif -%}
}

{% endif %}{% endfor %}{% for entry in padding_plans %}{% set plan = entry.plan %}/**
 * @param {string} integer
 * @param {string} fraction
 * @returns {string}
 */
function padTo{{ plan.min_significant }}SignificantDigits(integer, fraction) {
{% if entry.normalized %}  const current = integer === "0" ? 1 : integer.length + fraction.length;
{% else %}  const combined = `${integer}${fraction}`;
  const first = combined.search(/[1-9]/);
  const current = first < 0 ? 1 : combined.length - first;
{% endif %}  return fraction.padEnd(fraction.length + Math.max(0, {{ plan.min_significant }} - current), "0");
}

{% endfor %}{% for plan in rounding_plans %}{% with fraction_digits=plan.max_fraction, increment=plan.rounding, half=plan.rounding_half, half_fraction=plan.rounding_half_fraction, name=plan.rounding_helper %}{% include "number_rounding" %}{% endwith %}
{% endfor %}{% if significant_fraction_rounding %}/**
 * @param {__lgl_Decimal} decimal
 * @param {number} fractionDigits
 * @returns {{ "{{" }} integer: string, fraction: string }}
 */
function roundGeneratedFraction(decimal, fractionDigits) {
{% if not significant_fraction_bounded %}  if (fractionDigits > MAX_GENERATED_DECIMAL_DIGITS) throwInvalidNumber();
{% endif %}  const fraction = decimal.fraction.slice(0, fractionDigits).padEnd(fractionDigits, "0");
  if (decimal.fraction.length <= fractionDigits || decimal.fraction[fractionDigits] < "5") return { integer: decimal.integer, fraction };
  const digits = (BigInt(`${decimal.integer}${fraction}`) + 1n).toString().padStart(fractionDigits + 1, "0");
  return fractionDigits === 0
    ? { integer: digits, fraction: "" }
    : { integer: digits.slice(0, -fractionDigits), fraction: digits.slice(-fractionDigits) };
}

{% endif %}/** @returns {never} */
function throwInvalidNumber() {
  throw new RangeError("Linguini: invalid numeric value");
}
